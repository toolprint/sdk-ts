{
  "name": "@repo/onegrep-typescript-sdk",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "turbo run lint",
    "lint:staged": "turbo run lint",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check:prettier:staged": "pretty-quick --staged",
    "check:commit:msg:staged": "commitlint --edit \"$1\"",
    "prepare": "husky",
    "publish": "turbo run publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "check-licenses": "^1.1.0",
    "dotenv-cli": "^11.0.0",
    "dotenv-mono": "^1.5.1",
    "husky": "^9.1.5",
    "lint-staged": "^16.2.7",
    "pre-commit": "^1.2.2",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "turbo": "^2.8.3",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20 <=22"
  }
}
